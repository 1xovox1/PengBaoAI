# 复制此文件为 .env 并填入你的密钥（不要提交 .env 到 git）

# 服务端口（前端代理会请求此端口）
PORT=3001

# OpenAI（GPT-4 等） https://platform.openai.com/api-keys
OPENAI_API_KEY=

# 月之暗面 Kimi https://platform.moonshot.ai/
MOONSHOT_API_KEY=

# Anthropic Claude https://console.anthropic.com/
ANTHROPIC_API_KEY=

# DeepSeek https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# Dify Agent（推荐：在 Dify 上配置好模型后，只需填这里即可用你的 Agent，无需上面各厂商 Key）
# 使用 Dify 时：Dify 控制台里已配置好模型，这里只填 Dify 的地址和该应用的 API Key
DIFY_BASE_URL=

# 多个 Dify Agent 的 API Key（根据前端选择的模型 ID 自动选择）
DIFY_API_KEY_DEEPSEEK_V3=
DIFY_API_KEY_DEEPSEEK_TERMINUS=
DIFY_API_KEY_QWEN3=
DIFY_API_KEY_DOUBAO=
DIFY_API_KEY_KIMI_K25=
DIFY_API_KEY_GLM47=

# 默认 Dify Agent（兼容旧代码）
DIFY_API_KEY=

# 文心一言（百度）如需接入请在后端 routes 中扩展
# WENXIN_API_KEY=
# WENXIN_SECRET=
